+def test_verdict_on_latest(client, two_rounds):  # AC1
+    task, _, r2 = two_rounds
+    body = {"verdict": "CHANGES", "body_md": "1. app/limits.py:31 trusts X-Forwarded-For …"}
+    r = put(client, task, "security", body)
