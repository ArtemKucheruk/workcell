+def frontmatter(text) -> tuple[str, str]:
+    """A SKILL.md's (frontmatter, body); it must start with a `---` block."""
+    assert text.startswith("---\n")
+    front, body = text[4:].split("\n---\n", 1)
+    return front, body
+
