+def add_task(project_id, status="in_progress", stage=None, position=1.0, worktree=None):
+    return sql(
+        "INSERT INTO tasks (project_id, title, status, stage, position, worktree_path, created_at, updated_at)"
+        " VALUES (?, 't', ?, ?, ?, ?, ?, ?) RETURNING id",
