+    (repo / "old.py").unlink()
+    write(repo, {"new.py": "".join(["changed\n"] + lines[1:])})
+    (repo / "x.txt").rename(repo / "y.txt")
+    assert split(client, task, captured(repo, monkeypatch)) == [
+        ("new.py", "old.py", "renamed", 0, 1, 1),
+        ("y.txt", "x.txt", "renamed", 0, 0, 0),
+    ]
